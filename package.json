{
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  },
  "scripts": {
    "start:dev": "concurrently \"yarn --cwd backends/botz.ai start:dev\" \"yarn --cwd www/botz.ai start:dev\"",
    "start:today:dev": "concurrently \"yarn --cwd backends/today.zoto.io start:dev\" \"yarn --cwd www/today.zoto.io start:dev\"",
    "start:zoto:dev": "concurrently \"yarn --cwd backends/zoto.io start:dev\" \"yarn --cwd www/zoto.io start:dev\"",
    "generate:nginx": "node scripts/generate-nginx.js",
    "check:nginx": "node scripts/generate-nginx.js --check",
    "check:botz-projects": "node scripts/validate-botz-projects.js"
  }
}
