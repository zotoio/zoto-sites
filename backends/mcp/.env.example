# mcp.botz.ai (botz-mcp). Copy to backends/mcp/.env on the droplet (chmod 600, never commit).
# GitHub OAuth App: Homepage https://mcp.botz.ai, Authorization callback URL https://mcp.botz.ai/
# (the origin, so both /auth/callback [MCP OAuth] and /admin/auth/callback [console] match).
BOTZ_GITHUB_CLIENT_ID=
BOTZ_GITHUB_CLIENT_SECRET=
# Same org as swarm (backends/swarm/.env GITHUB_ALLOWED_ORG)
BOTZ_GITHUB_ALLOWED_ORG=
# GitHub team (org/slug) -> role. Roles: viewer < operator < team_admin < super_admin
BOTZ_ROLE_MAPPINGS=[{"provider":"github","team":"ORG/botz-admins","role":"super_admin"},{"provider":"github","team":"ORG/botz-operators","role":"operator"},{"provider":"github","team":"ORG/botz-viewers","role":"viewer"}]
# Org members in no mapped team: empty = denied, or e.g. viewer
BOTZ_GITHUB_DEFAULT_ROLE=
# openssl rand -hex 32 (each)
BOTZ_SESSION_SECRET=
BOTZ_MCP_JWT_SIGNING_KEY=
# Cursor API key for skill generation (cursor:grok-4.7)
BOTZ_CURSOR_API_KEY=
# Optional per-model params, e.g. {"reasoning_effort":"medium"}
# BOTZ_CURSOR_MODEL_PARAMS=
