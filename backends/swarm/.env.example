# swarm.botz.ai (botz-mcp-swarm). Copy to backends/swarm/.env on the droplet (chmod 600, never commit).
# GitHub OAuth App callback URL: https://swarm.botz.ai/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_ORG=zotoio
# Optional: restrict to teams in the org (comma-separated)
# GITHUB_TEAM_SLUGS=
# Optional
# SWARM_CRON_TZ=Australia/Sydney
# LLM features are intentionally off: leave all *_API_KEY / SWARM_LLM_* unset.
# Telemetry ingest HMAC (POST /api/telemetry/ingest). openssl rand -hex 32. Required for signed
# (non-session, non-API-key) ingest; unset = HMAC path fails closed. Copy the SAME value into
# backends/mcp/.env as BOTZ_SWARM_TELEMETRY_HMAC_SECRET. Signature: X-Swarm-Signature: sha256=<hex HMAC-SHA256(secret, rawBody)>
SWARM_TELEMETRY_HMAC_SECRET=
# Optional: Swarm's own local OTEL collector (separate from botz-mcp/CLI collectors)
# SWARM_OTEL_EXPORTER_OTLP_ENDPOINT=
