# botz.ai Express API — copy to .env and fill in values.
# Required for the service to start.

OPENAI_API_KEY=
NEWS_API_KEY=
SHARED_SECRET=

# Optional overrides (defaults shown)
# PORT=3000
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_MODEL_WEAK=gpt-3.5-turbo-0125
# OPENAI_IMAGE_QUALITY=standard
# FREQUENCY=daily
# PAGE_SIZE=1
# PAGE_COUNT=1
# SINGLE_RANDOM=true
# CACHE=true
# CATEGORY_HOURS=12
CACHE_DIR=/home/root/cache

# Cloudflare cache purge after new editorials (recommended for botz.ai zone)
# CF_ZONE_ID=
# CF_API_TOKEN=

# Used when generating editorial URLs for external callers
# EDITORIAL_API_URL_PREFIX=https://botz.ai
