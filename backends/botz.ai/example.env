# Default news source: Hacker News via Algolia (no API key). Set to thenewsapi for legacy The News API.
NEWS_SOURCE=hn
# Required only when NEWS_SOURCE=thenewsapi
NEWS_API_KEY=
# Minimum HN points for candidate stories (default 20)
# HN_MIN_POINTS=20
OPENAI_API_KEY=your_api_key_from_openai.com
FREQUENCY=hourly
PAGE_SIZE=3
PAGE_COUNT=1 
SINGLE_RANDOM=true
CATEGORY_HOURS=4
CACHE_DIR=/home/root/cache
CACHE=true
SHARED_SECRET=CHANGE_ME
CF_ZONE_ID=
CF_API_TOKEN=# Story generation schedule as run by the host crontab ("m h * * *" lines, ";"-separated), its clock's offset from
# UTC in minutes, and the typical seconds from a run starting to its story being live. Published to the site as
# `generation` in /archive/index and /archive/latest (drives the "next story in mm:ss" countdown).
# GENERATION_SCHEDULE=1 * * * *
# GENERATION_TZ_OFFSET_MIN=0
# GENERATION_DELAY_S=180
CF_API_TOKEN=
# Multi-provider article sources (comma separated; default/unset = hn only, original behaviour).
# Providers: hn (Algolia, keyless), thenewsapi (needs NEWS_API_KEY; skipped with a log line if missing),
# ddg (DuckDuckGo HTML), gnews (Google News RSS), bingnews (Bing News RSS) - the last three are keyless, live-only.
# thenewstack (The New Stack RSS, keyless, live-only, 1 request per run).
# NEWS_PROVIDERS=hn,thenewsapi,gnews,bingnews,thenewstack
# Cross-provider source weighting (picks the top-25 sent to LLM scoring); all optional, defaults shown.
# SOURCE_WEIGHTS=hn=1.0,thenewsapi=0.9,thenewstack=0.9,gnews=0.8,bingnews=0.8,ddg=0.7
# SOURCE_RECENCY_HALF_LIFE_HOURS=12
# SOURCE_COMPONENT_WEIGHTS=keyword=0.45,recency=0.3,engagement=0.25
# SOURCE_AUTHORITY_BONUS=0.05
# SOURCE_AUTHORITY_DOMAINS=reuters.com,apnews.com,bbc.com,theverge.com,arstechnica.com,techcrunch.com,wired.com,nytimes.com,ft.com,bloomberg.com,technologyreview.com,anthropic.com,openai.com,deepmind.google,thenewstack.io
# SOURCE_MULTI_PROVIDER_BONUS=0.05
# Optional Jev (Typesafe.ai System One) relevance classifier, combined with the keyword score. Skipped when no key.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.14.0
# Multi-provider: Jev runs on every merged candidate BEFORE article page fetch (combined 0.4*kw/10+0.6*jev >= threshold).
# JEV_PREFILTER_THRESHOLD=0.35
# JEV_PREFILTER_CONCURRENCY=5

# Optional HTTP proxy for ARTICLE PAGE fetches only (not HN/Algolia, OpenAI, news API, search providers or Jev).
# e.g. a tinyproxy on a home host over Tailscale. Unset = always direct.
# ARTICLE_FETCH_PROXY=http://100.x.y.z:8888
# fallback (default): direct first, retry once via proxy on 403, 429 or Cloudflare challenge (cf-mitigated). always: proxy only.
# ARTICLE_FETCH_PROXY_MODE=fallback

# Exponential backoff on HTTP 429 for ARTICLE PAGE fetches only (direct and proxy). Honours numeric Retry-After; +up to 20% jitter.
# delay = min(BASE_MS * 2^attempt, MAX_MS). Defaults shown.
# ARTICLE_FETCH_429_RETRIES=3
# ARTICLE_FETCH_429_BASE_MS=1000
# ARTICLE_FETCH_429_MAX_MS=30000
# Host-level route memory (fallback mode + proxy only): remember per host whether direct or proxy works.
# ARTICLE_FETCH_ROUTE_TTL_HOURS=24
# ARTICLE_FETCH_ROUTE_CACHE=/home/root/cache/article-fetch-routes.json
