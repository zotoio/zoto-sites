# Default news source: Hacker News via Algolia (no API key). Set to thenewsapi for legacy The News API.
NEWS_SOURCE=hn
# Required only when NEWS_SOURCE=thenewsapi
NEWS_API_KEY=
# Minimum HN points for candidate stories (default 20)
# HN_MIN_POINTS=20
OPENAI_API_KEY=your_api_key_from_openai.com
FREQUENCY=hourly
PAGE_SIZE=3
PAGE_COUNT=1 
SINGLE_RANDOM=true
CATEGORY_HOURS=4
CACHE_DIR=/home/root/cache
CACHE=true
SHARED_SECRET=CHANGE_ME
CF_ZONE_ID=
CF_API_TOKEN=# Story generation schedule as run by the host crontab ("m h * * *" lines, ";"-separated), its clock's offset from
# UTC in minutes, and the typical seconds from a run starting to its story being live. Published to the site as
# `generation` in /archive/index and /archive/latest (drives the "next story in mm:ss" countdown).
# GENERATION_SCHEDULE=1 * * * *;0 20 * * *
# GENERATION_TZ_OFFSET_MIN=0
# GENERATION_DELAY_S=90
