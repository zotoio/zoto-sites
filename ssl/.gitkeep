# Origin TLS certificates for the nginx container (synced from host Let's Encrypt).
# docker-compose mounts this directory to /etc/nginx/ssl (read-only).
#
# Production: run ./scripts/sync-ssl.sh on the droplet to copy from
#   /etc/letsencrypt/live/<name>/fullchain.pem and privkey.pem
#
# See docs/DEPLOYMENT.md (Cloudflare Full Strict + host LE renewal).
