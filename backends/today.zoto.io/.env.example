# Required (same provider as backends/botz.ai — api.thenewsapi.com)
NEWS_API_KEY=

# Optional
PORT=3001

# Optional — live global webcams (https://api.windy.com/webcams/docs)
WINDY_WEBCAMS_KEY=

# Optional — NSW Live Traffic cameras (https://opendata.transport.nsw.gov.au/)
TRANSPORT_NSW_API_KEY=

# Optional — QLDTraffic v1 API (open ArcGIS layer is used without this key)
QLDTRAFFIC_API_KEY=
